{
  "name": "trama",
  "version": "1.0.0",
  "description": "A production-oriented web hosting platform. Upload a ZIP → Automatic deployment → Live URL",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "NODE_ENV=development nodemon --exec node server/index.js",
    "client:dev": "cd client && vite",
    "build": "cd client && vite build",
    "preview": "cd client && vite preview",
    "start": "node server/index.js",
    "seed": "node server/scripts/seed.js"
  },
  "keywords": [
    "hosting",
    "deployment",
    "zip",
    "static",
    "serverless"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.1",
    "jsonwebtoken": "^9.1.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "node-uuid": "^1.4.8",
    "pg": "^8.11.2",
    "unzipper": "^0.10.14",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.1.1",
    "concurrently": "^8.2.1",
    "nodemon": "^3.0.1",
    "vite": "^5.0.2"
  }
}
